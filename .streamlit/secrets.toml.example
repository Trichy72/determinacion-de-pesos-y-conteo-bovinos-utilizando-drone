# =====================================================================
# Plantilla de secrets para Streamlit Cloud — HMS Nutrición Animal
# =====================================================================
# Cómo se usa:
#
#   1. NO cargues valores reales en este archivo — es solo checklist.
#   2. En Streamlit Cloud (https://share.streamlit.io/) entrás a tu app,
#      click en "⋮" -> "Settings" -> tab "Secrets" y pegás el contenido
#      de acá reemplazando los valores por los reales.
#   3. La app los lee via os.environ (Streamlit expone los secrets
#      también como variables de entorno), igual que GitHub Actions.
#
# Los nombres de acá son EXACTAMENTE los 22 que lee el código y los
# mismos que declaran los workflows de .github/workflows/. Si cambiás
# uno, cambialo en los tres lugares: código, GitHub Secrets y este
# archivo. Ver MIGRACION_NUBE_SECRETS.md para el paso a paso.
#
# El adapter `src/db_backend.py` detecta DATABASE_URL en env y activa
# el modo Postgres automáticamente.
# =====================================================================

# --- Base de datos (Supabase Postgres, session pooler) ---
DATABASE_URL = "postgresql://postgres.<REF>:<PASSWORD>@aws-1-us-west-2.pooler.supabase.com:5432/postgres"

# --- API de Anthropic (Claude) ---
ANTHROPIC_API_KEY = "sk-ant-api03-..."

# --- SMTP para emails ---
SMTP_HOST = "smtp-relay.brevo.com"
SMTP_PORT = "587"
SMTP_USER = "..."
SMTP_PASSWORD = "..."
SMTP_FROM_EMAIL = "alertas@hmsnutricionanimal.com.ar"
SMTP_FROM_NAME = "HMS Nutrición Animal"
SMTP_USE_SSL = "false"
SMTP_USE_TLS = "true"
SMTP_ADMIN_EMAIL = "alertas@hmsnutricionanimal.com.ar"
# Dirección que recibe copia oculta de cada email a cliente. Acepta un
# email (recomendado, igual que el JSON local), varios separados por
# comas, o "true" para caer a SMTP_ADMIN_EMAIL. Con "false" no manda BCC.
SMTP_BCC_CLIENTES = "mauricio@hmsnutricionanimal.com.ar"

# --- IMAP (procesar bajas por email) ---
IMAP_HOST = "imap.mail.me.com"
IMAP_USER = "..."
IMAP_PASSWORD = "..."

# --- WhatsApp (Twilio) ---
# Sin el prefijo "whatsapp:": el código lo agrega solo.
TWILIO_ACCOUNT_SID = "AC..."
TWILIO_AUTH_TOKEN = "..."
TWILIO_FROM_NUMBER = "+14155238886"
TWILIO_ADMIN_PHONE = "+5492954517407"
TWILIO_MODO_SANDBOX = "true"
# URL pública de la mini-app de carga. Ojo: si es un túnel ngrok free,
# la URL cambia en cada reinicio y hay que actualizarla acá.
CARGA_BASE_URL = "https://.../carga"

# --- WeatherAPI.com ---
WEATHERAPI_KEY = "..."
